# Salin file ini menjadi .env.local untuk uji coba lokal,
# dan isi variabel yang sama di Vercel: Project → Settings → Environment Variables.

# URL Web App dari Google Apps Script (Deploy → New deployment → Web app), berakhiran /exec
GAS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Harus sama persis dengan ORDER_SECRET yang muncul di log saat menjalankan setup() di Apps Script
ORDER_SECRET=isi-dengan-secret-dari-apps-script
